# claude-mem worker (legacy runtime) for the isolated local stack.
# Build context: repository root (needs plugin/).
FROM oven/bun:1.3.12 AS bun

# trixie (glibc 2.41): the tree-sitter-cli binary needs glibc >= 2.39, bookworm has 2.36.
FROM node:22-trixie
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates tini jq \
 && apt-get clean

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun

COPY plugin/ /opt/claude-mem/
RUN chown -R node:node /opt/claude-mem
USER node
RUN cd /opt/claude-mem \
 && ONNXRUNTIME_NODE_INSTALL_CUDA=skip npm install --omit=dev --legacy-peer-deps \
 && npm cache clean --force

USER root
RUN mkdir -p /data && chown node:node /data
COPY --chown=node:node deploy/local-docker/entrypoint.sh /usr/local/bin/claude-mem-entrypoint
RUN chmod +x /usr/local/bin/claude-mem-entrypoint

USER node
ENV CLAUDE_MEM_DATA_DIR=/data \
    HOME=/home/node \
    DO_NOT_TRACK=1
WORKDIR /home/node
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/claude-mem-entrypoint"]
