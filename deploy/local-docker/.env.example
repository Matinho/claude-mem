# Copy to .env and fill in. Never commit .env.
# Generate each token with:  openssl rand -hex 32
CLAUDE_MEM_LOCAL_API_TOKEN=
CLAUDE_MEM_WORKER_INGEST_TOKEN=

# Exact name shown by `ollama list` (pulled once by the setup step).
OLLAMA_MODEL=qwen2.5:3b

# Host port, bound to 127.0.0.1 only.
CLAUDE_MEM_PORT=37777

# Pin a concrete tag once you have a version that works.
OLLAMA_TAG=latest
